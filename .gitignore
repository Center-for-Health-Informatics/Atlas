/node_modules/
/js/assets/bundle
/js/assets/fonts
/js/assets/images
js/version.js
.env.local
.env.*.local
.envrc

# Track only the project skills under .claude/; local settings and caches are
# personal. The `.claude/*` + re-include pairing is required because git will
# not re-include a path whose parent directory is excluded -- `.claude/` on its
# own would make `!.claude/skills/` unreachable.
.claude/*
!.claude/skills/
.claude/skills/run-atlas/scripts/screenshots/
