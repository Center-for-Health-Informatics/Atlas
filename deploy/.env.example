# Copy to .env alongside compose.yaml on the deployment host.

TZ=America/New_York

# Port published on the host; the container always listens on 8080.
HTTP_PORT=8080

# URL the *browser* uses to reach WebAPI, so it must be resolvable from the
# client, not just from inside the container. Trailing slash is normalized.
WEBAPI_URL=https://chi-cetus.uc.edu/WebAPI/

ATLAS_INSTANCE_NAME=CHI
